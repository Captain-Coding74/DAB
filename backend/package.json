{
  "name": "@dab/backend",
  "version": "20.4.0",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=production node src/server.js",
    "dev": "cross-env NODE_ENV=development node --watch src/server.js",
    "test": "node --test src/stats.test.js src/insights.test.js src/agent.test.js src/streaming.test.js src/normalize.test.js src/telemetry.test.js src/aiBudget.test.js",
    "test:integration": "cross-env JWT_SECRET=test-secret-32chars-long!!!! JWT_REFRESH_SECRET=test-refresh-32chars-long! NODE_ENV=test node --test --test-concurrency=1 src/integration.test.js src/routes.test.js",
    "test:all": "npm test && npm run test:integration",
    "test:smoke": "echo 'Requires a running server on :3099 — see src/scripts/smoketest.mjs header for full boot command' && node src/scripts/smoketest.mjs",
    "db:migrate": "node src/db/migrate.js",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=120000 e2e/flows.test.mjs e2e/boot.test.mjs",
    "perf:api": "node scripts/perf-api.mjs",
    "test:browser": "node --test --test-concurrency=1 --test-timeout=180000 e2e/browser.test.mjs",
    "telemetry": "node src/scripts/telemetry-report.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@libsql/client": "^0.14.0",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-slow-down": "^2.0.3",
    "helmet": "^7.2.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.2",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "cross-env": "^7.0.3",
    "supertest": "^7.0.0"
  }
}
