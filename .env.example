# ── Required ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Token-signing secrets. Required in production and by docker compose; blank
# falls back to built-in development secrets outside production only.
# v21.30: these used to hold placeholder text, which a copied .env carried
# into production unchanged. Generate each one: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Database (leave blank for SQLite) ─────────────────────
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Postgres TLS (v21.30). A remote database is reached over TLS, but by
# default its certificate is NOT checked (what Railway / Supabase need out of
# the box), so anything on the network path could pose as the database.
# Production logs a warning at boot while the certificate goes unchecked:
#   DATABASE_SSL_CA      the CA that signed the server's certificate — the PEM
#                        text itself (a literal \n for line breaks is fine) or
#                        a path to a .pem file. Your provider publishes it.
#   DATABASE_SSL_VERIFY  1 = verify against the system's trusted CAs (for a
#                        database with a publicly trusted certificate).
# Either one replaces any sslmode=… in DATABASE_URL. Without them, sslmode in
# the URL still decides; localhost and sslmode=disable mean no TLS at all.
# DATABASE_SSL_CA=/etc/ssl/certs/db-ca.pem
# DATABASE_SSL_VERIFY=1

# ── Cache (leave blank for in-memory) ─────────────────────
# REDIS_URL=redis://user:pass@host:6379

# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# How many reverse-proxy hops sit in front of Node. Decides whether
# X-Forwarded-For is trusted when deriving req.ip, which keys the login
# brute-force limiter. 0 when clients reach Node directly (the shipped
# docker-compose), 1 behind a single proxy (Railway, nginx, Caddy). Unset
# defaults to 1 for back-compat; never use a value you cannot justify from
# the real topology, since a too-high value lets clients forge their IP.
# TRUST_PROXY=1

# Max size an uploaded .xlsx may inflate to when opened (it is a ZIP). Defaults
# to 10× MAX_UPLOAD_MB; a real workbook inflates ~8×, a decompression bomb
# thousands of times. See backend/src/services/zipGuard.js.
# MAX_XLSX_INFLATED_MB=250

# Bearer token that lets a monitoring scraper (Prometheus, Grafana, uptime
# checks) read /api/metrics in production: Authorization: Bearer <token>.
# In production the endpoint is closed unless this is set or the caller is a
# signed-in TELEMETRY_ADMINS user; outside production it stays open for the
# perf and E2E tooling. Generate with: openssl rand -hex 32
# METRICS_TOKEN=

# ── AI cost guardrail (v20.3) ─────────────────────────────
# Global daily cap on Anthropic calls, all users combined. When exhausted
# the app keeps serving instant statistical analysis and AI resumes the
# next day. Anonymous uploads never call the AI at all.
AI_DAILY_BUDGET=300

# ── Object storage (v21.1) ───────────────────────────────
# Uploaded files live outside the database. `local` needs no configuration
# and writes under DATA_DIR/objects; `s3` targets any S3-compatible endpoint
# (AWS, Cloudflare R2, MinIO) and requires @aws-sdk/client-s3 installed.
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=dab
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Encryption at rest (v21.30), for both drivers. When set, every file saved
# from then on is encrypted with AES-256-GCM before it reaches the disk or the
# bucket, and any change to a stored byte is detected on read. 32 random
# bytes, as base64 or 64 hex characters — generate with: openssl rand -base64 32
# Production logs a warning at boot while this is unset. The Privacy Notice
# says whether stored files are encrypted from a check of the files (boot and
# daily), so set it, then encrypt older files right away (below). A malformed value
# stops the server from starting. Files saved before the key was set stay
# readable; encrypt them in place with (dry run first, then for real):
#   npm run storage-encrypt -w backend -- --dry-run
# KEEP A COPY OF THE KEY somewhere safe: encrypted files cannot be read
# without it, and changing it makes every file saved under the old key
# unreadable.
# STORAGE_ENCRYPTION_KEY=

# ── docker compose only (v21.30) ──────────────────────────
# docker-compose.yml has no default passwords: it refuses to start until
# these are set. POSTGRES_PASSWORD goes into a URL, so use letters and digits
# only — openssl rand -hex 24. MINIO_ROOT_PASSWORD needs 8+ characters. To
# use the bundled MinIO with STORAGE_DRIVER=s3, set AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY above to the same two MinIO values.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── Data retention (v21.30) ───────────────────────────────
# A daily job (03:17 Asia/Bangkok, and once about a minute after boot)
# deletes what is past these periods — see backend/src/services/retention.js.
# Each value is a positive whole number of days; anything else falls back to
# the default shown here, with a warning in the log. These defaults are the
# periods the Privacy Notice states, so change them only together with it.
# Trashed datasets are purged this long after they were moved to Trash.
# TRASH_RETENTION_DAYS=30
# Saved datasets with no activity (opened, analysed, tested, edited, new
# version) for this long are deleted with their analyses, chat and share links.
# DATASET_RETENTION_DAYS=365
# Analyses (with their chat and share links), counted from when they were made.
# ANALYSIS_RETENTION_DAYS=365
# Upload telemetry rows (file shape + column-category tags).
# TELEMETRY_RETENTION_DAYS=395
# audit_log rows (register / login / log-out-everywhere events).
# AUDIT_RETENTION_DAYS=365
# Activity feed and notifications.
# ACTIVITY_RETENTION_DAYS=365
# Privacy-request log (exports, account deletions, requests by email or post).
# Rows hold only a one-way hash of the user id; 3 years shows each was handled.
# PRIVACY_REQUEST_RETENTION_DAYS=1095
# Traffic log (Computer-Related Crime Act s.26): event, user id, IP, time and
# an optional id for register, login, logout, analyze, dataset upload, export,
# share-link create and view, data export and account deletion. No API reads
# it; it outlives account deletion until this period ends. The law sets 90
# days as a MINIMUM: a lower value is raised to 90 with a warning, and a
# higher one (an official order can ask for up to 2 years) is honoured.
# TRAFFIC_LOG_RETENTION_DAYS=90

# ── Telemetry (operator-only) ─────────────────────────────
# Comma-separated usernames allowed to read /api/telemetry/summary.
# The summary is anonymised but still reports things like "someone uploaded a
# pharmacy file with patient columns", which is close to identifying on a small
# deployment. Unset means nobody can read it.
# TELEMETRY_ADMINS=captain

# ── Legal pages (v21.30) ──────────────────────────────────
# Printed on /privacy, /terms and /contact (and returned by GET /api/legal).
# PDPA s.23 requires the controller's contact details, and ss.28–29 a basis
# or safeguard for keeping data with a host outside Thailand, so production
# warns at boot while any of the five below is empty; the pages then show a
# "being set up" line instead of a blank. Values are HTML-escaped.
# LEGAL_OPERATOR_NAME=Phatcharaphong Siriphatcharakul
# LEGAL_CONTACT_EMAIL=privacy@example.com
# LEGAL_POSTAL_ADDRESS=
# LEGAL_HOSTING_PROVIDER=
# LEGAL_HOSTING_REGION=
# The safeguard for that transfer, as confirmed with the host, e.g.
# "the provider's data-processing agreement, with standard contractual clauses"
# LEGAL_HOSTING_TRANSFER_BASIS=
